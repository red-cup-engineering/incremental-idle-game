{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:561:incremental-idle-game:world-catalog:v1",
  "title": "Little Worlds authored world catalog",
  "description": "The authored game rules. Cross-record identity and progression invariants are also admitted by defineWorld before generation.",
  "type": "array",
  "minItems": 1,
  "maxItems": 32,
  "items": { "$ref": "#/$defs/world" },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
    "points": { "type": "integer", "minimum": 0, "maximum": 1000000000000000 },
    "positivePoints": { "type": "integer", "minimum": 1, "maximum": 1000000000000000 },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "baseCost", "ratePerSecond", "growthBasisPoints", "unlockAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/text" },
        "baseCost": { "$ref": "#/$defs/positivePoints" },
        "ratePerSecond": { "$ref": "#/$defs/positivePoints" },
        "growthBasisPoints": { "type": "integer", "minimum": 10000, "maximum": 30000 },
        "unlockAt": { "$ref": "#/$defs/points" }
      }
    },
    "upgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "cost", "unlockAt", "effect", "amount"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/text" },
        "cost": { "$ref": "#/$defs/positivePoints" },
        "unlockAt": { "$ref": "#/$defs/points" },
        "effect": { "enum": ["tap", "production"] },
        "amount": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "label", "description", "unit", "verb", "offlineCapSeconds", "prestigeThreshold", "producers", "upgrades"],
      "properties": {
        "kind": { "const": "561.incremental-idle-world/v1" },
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "unit": { "$ref": "#/$defs/text" },
        "verb": { "$ref": "#/$defs/text" },
        "offlineCapSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "prestigeThreshold": { "type": "integer", "minimum": 100, "maximum": 1000000000000000 },
        "producers": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/producer" } },
        "upgrades": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/upgrade" } }
      }
    }
  }
}
